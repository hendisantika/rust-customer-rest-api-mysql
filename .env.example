# Application
SERVER_ADDR=0.0.0.0:8080
RUST_LOG=info,rust_customer_rest_api_mysql=debug,sqlx=warn

# Connection string used by the API (sqlx)
DATABASE_URL=mysql://customer:secret@127.0.0.1:3306/customer_db
DATABASE_MAX_CONNECTIONS=10

# Credentials used by docker-compose to bootstrap MySQL 9.7.0
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=customer_db
MYSQL_USER=customer
MYSQL_PASSWORD=secret
MYSQL_PORT=3306
