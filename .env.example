# Application
SERVER_ADDR=0.0.0.0:8088
RUST_LOG=info,rust_customer_rest_api_mysql=debug,sqlx=warn

# Connection string used by the API (sqlx)
DATABASE_URL=mysql://customer:secret@127.0.0.1:3306/customer_db
DATABASE_MAX_CONNECTIONS=10

# Set this to run the integration tests; they TRUNCATE the customers table,
# so it must point at a throw-away database (docker-compose creates this one).
TEST_DATABASE_URL=mysql://customer:secret@127.0.0.1:3306/customer_db_test

# Credentials used by docker-compose to bootstrap MySQL 26.7.0
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=customer_db
MYSQL_USER=customer
MYSQL_PASSWORD=secret
MYSQL_PORT=3306
